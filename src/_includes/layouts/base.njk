<!doctype html>
<html lang="en">

<head>
    {% include "components/seo.njk" %}
    <link rel="preload" href="/assets/fonts/maple-mono/MapleMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles/glightbox.css" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/prism.css" />
    {%- if not forceMotion %}
    <script>
        // Before rendering so nothing animates for the first frame.
        if (matchMedia("(prefers-reduced-motion: reduce)").matches || localStorage.getItem("animations") === "off") {
            document.documentElement.classList.add("no-motion");
        }
    </script>
    {%- endif %}
</head>

<body {% if bodyId %} id="{{ bodyId }}" {% endif %}{% if noDrawing %} no-drawing="true" {% endif %}>
    {%- if chrome === false %}
    {{ content | safe }}
    {%- else %}
    <main id="mainpage">
        {% include "components/header.njk" %}
        <div class="page-content">
            {{ content | safe }}
        </div>
        {% include "components/footer.njk" %}
    </main>
    {%- endif %}
    <script src="/scripts/glightbox.min.js"></script>
    <script type="module" src="/scripts/main.js"></script>
    <script type="module" src="/scripts/site-core.js"></script>
    {%- if metadata.goatcounter %}
    <script data-goatcounter="https://{{ metadata.goatcounter }}.goatcounter.com/count" async
        src="//gc.zgo.at/count.js"></script>
    {%- endif %}
</body>

</html>