<header id="top-bar">
    <div class="site-heading">
        <h1 class="site-title">
            <a href="/" style="color: inherit; text-decoration: none">Sami Shakkour</a>
        </h1>
        <nav class="social-links" aria-label="Social links">
            <a
                class="icon-link"
                href="https://www.linkedin.com/in/sami-shakkour/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn">
                {% include "icons/linkedin.svg" %}
            </a>
            <a
                class="icon-link"
                href="https://github.com/SamiSha99/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub">
                {% include "icons/github.svg" %}
            </a>
            <a
                class="icon-link"
                href="https://bsky.app/profile/sami.shakkour.dev"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Bluesky">
                {% include "icons/bluesky.svg" %}
            </a>
        </nav>
    </div>
    <div class="action-links">
        <a class="button" id="resume" onclick="resume()">Resume</a>
        <a class="button" id="email" onclick="areYouABotQuestionMark()">Email</a>
        <a class="button" id="blog" href="/blog/">Blog</a>
    </div>
</header>
<dialog id="resume-dialog">
    <div class="showcase-alert-dialog">
        <div>What kind of work are you interested in?</div>
        <hr />
        <div style="float: right">
            <a class="button" href="/assets/pdf/Sami_Shakkour_Full-Stack.pdf">Full-Stack</a>
            <a class="button" href="/assets/pdf/Sami_Shakkour_Game_Developer.pdf">Game Development</a>
            <a class="button" onclick="this.closest('dialog').close()">Cancel</a>
        </div>
    </div>
</dialog>
<dialog id="bot-dialog">
    <div class="showcase-alert-dialog">
        <div>Are you a Bot?</div>
        <hr />
        <div style="float: right">
            <a class="button primary" onclick="blockPage()">Yes! ✨</a>
            <a class="button" onclick="_0x3c5033()">No</a>
            <a class="button" onclick="this.closest('dialog').close()">Cancel</a>
        </div>
    </div>
</dialog>
