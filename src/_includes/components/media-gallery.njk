{% macro mediaGallery(media, scrollable, fallbackAlt) %}
{%- set gallery = fallbackAlt | slugify %}
<div class="expand-assets{% if scrollable %} expand-assets-scrollable{% endif %}">
    {%- for item in media %}
    {%- set caption = item.caption or "" %}
    {%- set altText = (caption | striptags) or fallbackAlt %}
    {%- if r/\.mp4$/i.test(item.src) %}
    <video
        src="/assets/videos/{{ item.src }}"
        aria-label="{{ altText }}"
        data-gallery="{{ gallery }}"
        data-description="{{ caption }}"></video>
    {%- else %}
    <img
        src="/assets/images/{{ item.src }}"
        alt="{{ altText }}"
        title="{{ altText }}"
        data-gallery="{{ gallery }}"
        data-description="{{ caption }}" />
    {%- endif %}
    {%- endfor %}
</div>
{% endmacro %}
