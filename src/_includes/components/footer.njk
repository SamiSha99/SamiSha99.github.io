<footer class="site-footer dashed-top">
    <div class="footer-info">
        © {% year %} Sami Shakkour
        <div>
            <a
                href="https://github.com/SamiSha99/SamiSha99.github.io/"
                target="_blank"
                rel="noopener noreferrer">sauce</a>
            -
            <a
                href="/sitemap"
                target="_blank"
                rel="noopener noreferrer">sitemap</a>
            -
            <a onclick="areYouABotQuestionMark()">email</a>
            -
            <a onclick="resume()">resume</a>
            <span id="animation-toggle">
                -
                <a onclick="toggleAnimations()">disable animations</a>
            </span>
        </div>
    </div>
    <nav class="social-links" aria-label="Social links">
        {%- for link in links | selectattr("footer") %}
        <a
            class="icon-link"
            href="{{ link.url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ link.name }}">
            {% include "icons/" + link.icon + ".svg" %}
        </a>
        {%- endfor %}
        <a class="icon-link" href="/blog/rss.xml" aria-label="Blog RSS feed">
            {% include "icons/rss.svg" %}
        </a>
    </nav>
    {%- if commit %}
    <div class="footer-commit">
        last updated
        <a
            href="https://github.com/SamiSha99/SamiSha99.github.io/commit/{{ commit.full }}"
            target="_blank"
            rel="noopener noreferrer">{{ commit.short }}</a>
        - {{ commit.date }}
    </div>
    {%- endif %}
</footer>