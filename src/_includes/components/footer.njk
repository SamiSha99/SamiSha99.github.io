<footer class="site-footer dashed-top">
    <div>
        © {% year %} Sami Shakkour -
        <a
            href="https://github.com/SamiSha99/SamiSha99.github.io/"
            target="_blank"
            rel="noopener noreferrer">sauce</a>
        -
        <a
            href="/sitemap"
            target="_blank"
            rel="noopener noreferrer">sitemap</a>
        <!--<a onclick="areYouABotQuestionMark()" class="e-hidden">&lt;Email&gt;</a> me for any inquiries :)-->
    </div>
    <nav class="social-links" aria-label="Social links">
        {%- for link in links | selectattr("footer") %}
        <a
            class="icon-link"
            href="{{ link.url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ link.name }}">
            {% include "icons/" + link.icon + ".svg" %}
        </a>
        {%- endfor %}
    </nav>
</footer>