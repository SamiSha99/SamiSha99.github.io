<footer class="site-footer dashed-top">
    <div>
        © {% year %} Sami Shakkour
        <div>
            <a
                href="https://github.com/SamiSha99/SamiSha99.github.io/"
                target="_blank"
                rel="noopener noreferrer">sauce</a>
            -
            <a
                href="/sitemap"
                target="_blank"
                rel="noopener noreferrer">sitemap</a>
            -
            <a onclick="areYouABotQuestionMark()">email</a>
            -
            <a onclick="resume()">resume</a>
        </div>
    </div>
    <nav class="social-links" aria-label="Social links">
        {%- for link in links | selectattr("footer") %}
        <a
            class="icon-link"
            href="{{ link.url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ link.name }}">
            {% include "icons/" + link.icon + ".svg" %}
        </a>
        {%- endfor %}
        <a class="icon-link" href="/blog/rss.xml" aria-label="Blog RSS feed">
            {% include "icons/rss.svg" %}
        </a>
    </nav>
</footer>