{%- set canonicalUrl = metadata.url + page.url -%}
{%- set previewImage = (image or titleCardImage) if preview !== false -%}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }}</title>
<meta name="description" content="{{ description | striptags }}" />
<meta name="author" content="Sami Shakkour" />
<link rel="canonical" href="{{ canonicalUrl }}" />
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

<meta property="og:type" content="website" />
<meta property="og:title" content="{{ title }}" />
<meta property="og:description" content="{{ description | striptags }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
{%- if previewImage %}
<meta property="og:image" content="{{ metadata.url + previewImage }}" />
{%- endif %}
<meta name="theme-color" content="#000000" />

<meta name="twitter:card" content="{{ 'summary_large_image' if previewImage else 'summary' }}" />
<meta name="twitter:title" content="{{ title }}" />
<meta name="twitter:description" content="{{ description | striptags }}" />
{%- if previewImage %}
<meta name="twitter:image" content="{{ metadata.url + previewImage }}" />
{%- endif %}