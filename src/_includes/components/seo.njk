{%- set canonicalUrl = metadata.url + page.url -%}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }}</title>
<meta name="description" content="{{ description | striptags }}" />
<meta name="author" content="Sami Shakkour" />
<link rel="canonical" href="{{ canonicalUrl }}" />
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
<link rel="alternate" type="application/rss+xml" title="Sami Shakkour's Blog" href="/blog/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:title" content="{{ title }}" />
<meta property="og:description" content="{{ description | striptags }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
{%- if image %}
<meta property="og:image" content="{{ metadata.url + image }}" />
{%- endif %}
<meta name="theme-color" content="#000000" />

<meta name="twitter:card" content="{{ 'summary_large_image' if image else 'summary' }}" />
<meta name="twitter:title" content="{{ title }}" />
<meta name="twitter:description" content="{{ description | striptags }}" />
{%- if image %}
<meta name="twitter:image" content="{{ metadata.url + image }}" />
{%- endif %}