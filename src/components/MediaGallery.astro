---
import { faVideo } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";

function stripHtml(html = "") {
    return html
        .replace(/<[^>]*>/g, "")
        .replace(/\s+/g, " ")
        .trim();
}

function publicImagePath(src: string) {
    return `/assets/images/${src.replace(/\.(png|jpe?g|gif)$/i, ".webp")}`;
}

interface MediaItem {
    type: "pic" | "vid";
    src: string;
    caption?: string;
    muted?: boolean;
}

interface Props {
    media: MediaItem[];
    scrollable?: boolean;
    fallbackAlt: string;
}

const { media, scrollable = false, fallbackAlt } = Astro.props;
---

<div class={`expand-assets${scrollable ? " expand-assets-scrollable" : ""}`}>
    {
        media.map((item: any) => {
            const caption = item.caption || "";
            const altText = stripHtml(caption) || fallbackAlt;

            if (item.type === "pic") {
                return (
                    <img
                        src={publicImagePath(item.src)}
                        alt={altText}
                        title={altText}
                        data-desc={caption}
                        onclick="showcaseImage(this)"
                    />
                );
            }

            return (
                <div class="expand-video" onclick="showcaseImage(this, true)">
                    <video aria-label={altText} muted={item.muted} preload="none">
                        <source
                            src={`/assets/videos/${item.src}`}
                            type="video/mp4"
                            data-desc={caption}
                            title={altText}
                        />
                    </video>
                    <div class="label-content">
                        <Icon icon={faVideo} />
                    </div>
                </div>
            );
        })
    }
</div>
