---
pagination:
  data: redirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Redirecting...</title>
    <meta http-equiv="refresh" content="0; url={{ redirect.to }}" />
</head>

<body>
    <p>Moved to <a href="{{ redirect.to }}">{{ redirect.to }}</a>.</p>
</body>

</html>