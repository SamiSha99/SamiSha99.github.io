description: My projects
chrome: false
---

<div style="width: 75%; margin: auto">
    <h1>I don't know how you got here, check out some links:</h1>
    <ul>
        {%- for project in collections.projects | sort(attribute="data.title") %}
        {%- if project.url != page.url %}
        <li><a href="{{ project.url }}">{{ project.data.title }}</a></li>
        {%- endif %}
        {%- endfor %}
        <li><a href="/">Main Page</a></li>
    </ul>
</div>